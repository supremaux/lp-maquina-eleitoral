---
import { Building2, UserCheck, Megaphone, Users2, ArrowRight } from '@lucide/astro';

const audiences = [
  {
    icon: Building2,
    badge: "MAJORITÁRIA",
    title: "Prefeitos e Candidatos ao Executivo",
    description: "Ideal para gestores que precisam apresentar propostas complexas, prestar contas das realizações da cidade e manter uma narrativa forte em momentos de crise ou sabatinas.",
    benefits: [
      "Comunicação institucional sem perder o apelo popular",
      "Estrutura para discursos em plenários e eventos comunitários",
      "Defesa rápida de mandato e prestação de contas"
    ]
  },
  {
    icon: UserCheck,
    badge: "PROPORCIONAL",
    title: "Vereadores e Candidatos ao Legislativo",
    description: "Perfeito para quem precisa de alto volume de presença diária, fiscalização de bairros, cobranças e engajamento rápido sem gastar horas elaborando pautas.",
    benefits: [
      "Transformação de visitas de bairro em pautas eleitorais",
      "Roteiros rápidos de Reels e TikTok para gravar na rua",
      "Posicionamento firme sobre pautas da comunidade"
    ]
  },
  {
    icon: Megaphone,
    badge: "EQUIPES & MARKETING",
    title: "Assessores, Consultores e Agências",
    description: "Grave mais conteúdo em menos tempo. A ferramenta serve como um assistente tático para alimentar o planejamento da equipe sem depender do 'bloqueio criativo' do candidato.",
    benefits: [
      "Padronização da qualidade entre múltiplos pré-candidatos",
      "Agilidade no envio de briefings de WhatsApp e Stories",
      "Economia de horas de reuniões de pauta diárias"
    ]
  }
];
---

<section id="publico" class="bg-[#182838] text-white py-20 px-4 md:px-8 border-b border-[#0894B0]/20">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 bg-[#0894B0]/10 text-[#70C0D8] border border-[#0894B0]/30 px-4 py-1.5 rounded-full font-extrabold text-sm uppercase tracking-widest mb-4">
        <Users2 class="w-4 h-4 text-[#0894B0]" />
        <span>PARA QUEM É A MÁQUINA</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-tight mb-6">
        Projetada para quem <span class="text-[#0894B0]">não pode perder tempo</span> nas eleições 2026.
      </h2>
      <p class="text-gray-300 text-lg md:text-xl font-normal">
        Ajuste a comunicação com precisão para o seu objetivo político, tamanho de equipe e momento de pré-campanha.
      </p>
    </div>

    <!-- Cards de Segmentação -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      {audiences.map((item) => {
        const IconComponent = item.icon;
        return (
          <div class="bg-gray-900/80 border border-gray-800 hover:border-[#0894B0] rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 shadow-xl group">
            <div>
              <!-- Header do Card -->
              <div class="flex items-center justify-between mb-6">
                <div class="w-14 h-14 rounded-xl bg-[#0894B0]/15 border border-[#0894B0]/30 flex items-center justify-center text-[#0894B0] group-hover:bg-[#0894B0] group-hover:text-white transition-all">
                  <IconComponent class="w-7 h-7" />
                </div>
                <span class="text-xs font-black text-[#70C0D8] bg-[#0894B0]/10 border border-[#0894B0]/20 px-3 py-1 rounded-md uppercase tracking-wider">
                  {item.badge}
                </span>
              </div>

              <!-- Conteúdo -->
              <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-[#70C0D8] transition-colors">
                {item.title}
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed mb-6">
                {item.description}
              </p>

              <!-- Lista de Benefícios -->
              <ul class="space-y-3 mb-8">
                {item.benefits.map((benefit) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-300">
                    <span class="text-[#0894B0] font-bold mt-0.5">•</span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-gray-800">
              <span class="text-xs text-gray-400 font-medium flex items-center gap-1">
                Pronto para uso imediato em mandato ou pré-campanha.
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Banner Chamada Final -->
    <div class="bg-gradient-to-r from-gray-900 via-[#182838] to-gray-900 border border-[#0894B0]/40 rounded-2xl p-8 text-center flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-left">
        <h3 class="text-2xl font-bold text-white mb-2">
          Independente do seu cargo, a sua narrativa precisa de velocidade.
        </h3>
        <p class="text-gray-300 text-sm md:text-base">
          Garanta o acesso da sua equipe à Máquina de Conteúdo Eleitoral hoje mesmo.
        </p>
      </div>

      <a 
        href="#oferta" 
        class="inline-flex items-center gap-2 bg-[#F04820] hover:bg-[#d03b18] text-white font-extrabold px-8 py-4 rounded-xl text-base uppercase tracking-wide shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5 flex-shrink-0"
      >
        <span>Garantir Acesso Agora</span>
        <ArrowRight class="w-5 h-5" />
      </a>
    </div>

  </div>
</section>