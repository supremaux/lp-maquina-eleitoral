---
import {
  Search,
  Eye,
  Sparkles,
  ShieldAlert,
  Cpu,
  ArrowRight,
  CheckCircle2,
} from "@lucide/astro";

const spyModes = [
  {
    mode: "MODO 1",
    title: "Investigar Perfil (@)",
    description:
      "Digite o @ ou link do perfil público no Instagram, TikTok, YouTube ou X. A Máquina analisa o período selecionado (30, 60 ou 90 dias) e identifica os padrões de retenção, ganchos e narrativas de maior alcance.",
    features: [
      "Identificação de aberturas de alto impacto",
      "Análise de frequência e formatos de maior engajamento",
      "Mapeamento do tom e estilo de narrativa",
    ],
  },
  {
    mode: "MODO 2",
    title: "Analisar Material Direto",
    description:
      "Cole transcrições, legendas, roteiros, notícias ou links de vídeos virais. A Máquina desmonta a estrutura do conteúdo e extrai a arquitetura exata por trás da mensagem.",
    features: [
      "Desconstrução de roteiros de Reels e Carrosséis",
      "Análise de tom e gatilhos de retenção",
      "Extração do modelo estrutural para replicar",
    ],
  },
];

const pillars = [
  {
    title: "Observar",
    desc: "Mapeie os conteúdos com maior alcance do perfil analisado.",
  },
  {
    title: "Entender",
    desc: "Desmonte a estrutura de abertura, retenção, prova e CTA.",
  },
  {
    title: "Modelar",
    desc: "Adapte a técnica ao seu território, cargo e pautas reais.",
  },
];
---

<section
  id="spy"
  class="bg-[#182838] text-white py-20 px-4 md:px-8 border-b border-[#0894B0]/20 relative overflow-hidden"
>
  <!-- Elemento de Fundo Decorativo -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-[#0894B0]/10 rounded-full filter blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div
        class="inline-flex items-center gap-2 bg-[#0894B0]/15 text-[#70C0D8] border border-[#0894B0]/40 px-4 py-1.5 rounded-full font-extrabold text-sm uppercase tracking-widest mb-4"
      >
        <Eye class="w-6 h-6 text-[#0894B0]" />
        <span class="text-md">RECURSO EXCLUSIVO · RECURSO SPY</span>
      </div>
      <h2
        class="text-3xl md:text-5xl font-black tracking-tight leading-tight mb-6"
      >
        Aprenda com perfis de sucesso <span class="text-[#0894B0]"
          >sem virar cópia.</span
        >
      </h2>
      <p class="text-gray-300 text-lg md:text-xl font-normal">
        O Módulo SPY faz a engenharia reversa das melhores estratégias da
        internet para adaptar a técnica à sua realidade eleitoral.
      </p>
    </div>

    <!-- Regra de Ouro / Aviso da Ferramenta -->
    <div
      class="bg-gradient-to-r from-gray-900 via-[#182838] to-gray-900 border border-[#F04820]/40 rounded-2xl p-6 md:p-8 mb-16 flex flex-col md:flex-row items-center gap-6 shadow-xl"
    >
      <div
        class="w-14 h-14 rounded-xl bg-[#F04820]/15 border border-[#F04820]/40 flex items-center justify-center text-[#F04820] flex-shrink-0"
      >
        <ShieldAlert class="w-7 h-7" />
      </div>
      <div>
        <h3
          class="text-lg font-bold text-white mb-1 uppercase tracking-wide flex items-center gap-2"
        >
          Princípio Central da Modelagem Tática
        </h3>
        <p class="text-gray-300 text-sm md:text-base">
          O objetivo do SPY <strong class="text-white">não é copiar</strong> textos,
          bordões ou identidade de terceiros. É aprender a <strong
            class="text-[#70C0D8]"
            >técnica, retenção e arquitetura de narrativa</strong
          > para aplicar nas suas pautas com autenticidade.
        </p>
      </div>
    </div>

    <!-- Os 3 Pilares do Método -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {
        pillars.map((pillar, index) => (
          <div class="bg-gray-900/60 border border-gray-800 rounded-xl p-6 flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-[#0894B0] text-white font-black text-lg flex items-center justify-center flex-shrink-0">
              {index + 1}
            </div>
            <div>
              <h4 class="text-xl font-bold text-white mb-1">{pillar.title}</h4>
              <p class="text-gray-400 text-sm">{pillar.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Grid dos Modos de Operação (Modo 1 e Modo 2) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {
        spyModes.map((item) => (
          <div class="bg-gray-900/90 border border-gray-800 hover:border-[#0894B0]/60 rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 shadow-xl relative">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-black text-[#0894B0] bg-[#0894B0]/10 border border-[#0894B0]/30 px-3 py-1 rounded-md uppercase tracking-wider">
                  {item.mode}
                </span>
                <Cpu class="w-5 h-5 text-gray-500" />
              </div>

              <h3 class="text-2xl font-bold text-white mb-4">{item.title}</h3>

              <p class="text-gray-300 text-sm leading-relaxed mb-6">
                {item.description}
              </p>

              <ul class="space-y-3 mb-8">
                {item.features.map((feat) => (
                  <li class="flex items-center gap-3 text-sm text-gray-200">
                    <CheckCircle2 class="w-4 h-4 text-[#0894B0] flex-shrink-0" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-gray-800">
              <span class="text-xs text-gray-400 font-medium">
                Pronto para gerar briefing executivo + instrução completa de
                modelagem.
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA da Seção -->
    <div class="text-center">
      <a
        href="#oferta"
        class="inline-flex items-center gap-3 bg-[#F04820] hover:bg-[#d03b18] text-white font-extrabold px-8 py-4 rounded-xl text-lg uppercase tracking-wide shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-0.5"
      >
        <Search class="w-8 h-8" />
        <span>Ativar o Módulo SPY na Minha Campanha</span>
        <ArrowRight class="w-8 h-8" />
      </a>
    </div>
  </div>
</section>
