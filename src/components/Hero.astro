---
import { ShieldCheck, Zap } from "@lucide/astro";
---

<!-- BARRA FIXA DO CONTADOR REGRESSIVO (STICKY) -->
<div
  class="sticky top-0 z-50 bg-[#182838]/95 backdrop-blur-md border-b-2 border-[#F04820] py-3 px-4 shadow-2xl"
>
  <div
    class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center"
  >
    <div
      class="flex items-center gap-2 text-[#F04820] font-black text-xs sm:text-sm uppercase tracking-widest animate-pulse"
    >
      <Zap class="w-6 h-6 fill-current shrink-0" />
      <span class="text-3xl">ELEIÇÕES 2026 EM:</span>
    </div>

    <!-- Digitos Regressivos -->
    <div
      class="flex items-center gap-1.5 font-mono text-white text-lg font-black"
    >
      <div
        class="bg-[#F04820]/20 border border-[#F04820]/50 px-2 py-0.5 rounded text-[#F04820]"
      >
        <span id="countdown-days">00</span><span
          class="text-[12px] ml-0.5 font-sans text-gray-300">D</span
        >
      </div>
      <span>:</span>
      <div class="bg-gray-900 border border-gray-700 px-2 py-0.5 rounded">
        <span id="countdown-hours">00</span><span
          class="text-[12px] ml-0.5 font-sans text-gray-400">H</span
        >
      </div>
      <span>:</span>
      <div class="bg-gray-900 border border-gray-700 px-2 py-0.5 rounded">
        <span id="countdown-minutes">00</span><span
          class="text-[12px] ml-0.5 font-sans text-gray-400">M</span
        >
      </div>
      <span>:</span>
      <div class="bg-gray-900 border border-gray-700 px-2 py-0.5 rounded">
        <span id="countdown-seconds" class="text-[#70C0D8]">00</span><span
          class="text-[12px] ml-0.5 font-sans text-gray-400">S</span
        >
      </div>
    </div>
  </div>
</div>

<section
  class="bg-[#182838] text-white pt-10 pb-20 px-4 md:px-8 border-b-4 border-[#F04820]"
>
  <div class="max-w-6xl mx-auto text-center">
    <!-- H1 Headline -->
    <h1
      class="text-3xl md:text-5xl lg:text-6xl font-black tracking-tight max-w-4xl mx-auto leading-tight mb-6"
    >
      E você ainda perde tempo pensando no que postar? <span
        class="text-[#F04820]">A campanha já começou.</span
      >
    </h1>

    <p
      class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-8 font-normal"
    >
      A Máquina de Conteúdo Eleitoral transforma pautas, propostas, agenda e
      posicionamentos em conteúdos estratégicos para Reels, Carrosséis, Stories
      e Discursos.
    </p>

    <!-- Visual Mockup com Lazy Loading Otimizado -->
    <div
      class="relative max-w-3xl mx-auto mb-10 shadow-2xl rounded-xl overflow-hidden border-2 border-[#0894B0]/40"
    >
      <img
        src="/mockup.avif"
        alt="Mockup da Máquina de Conteúdo Eleitoral"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        class="w-full h-auto object-cover"
      />
    </div>

    <!-- Call To Action Principal -->
    <div class="flex flex-col items-center gap-3">
      <a
        href="https://pay.hotmart.com/SEU_LINK_AQUI"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-5 bg-[#F04820] hover:bg-[#d03b18] text-white font-extrabold text-xl rounded-lg shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-0.5 text-center uppercase tracking-wide"
      >
        QUERO ATIVAR MINHA MÁQUINA
      </a>
      <span class="text-sm text-gray-400 flex items-center gap-1">
        <ShieldCheck class="w-4 h-4 text-[#70C0D8]" /> R$ 97 por mês. Cancele quando
        quiser.
      </span>
    </div>
  </div>
</section>

<!-- Script para atualização do contador regressivo em tempo real -->
<script is:inline>
  function updateCountdown() {
    const targetDate = new Date("2026-10-04T00:00:00Z").getTime();
    const now = new Date().getTime();
    const timeDiff = targetDate - now;

    if (timeDiff <= 0) {
      return;
    }

    const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeDiff % (1000 * 60)) / 1000);

    const daysEl = document.getElementById("countdown-days");
    const hoursEl = document.getElementById("countdown-hours");
    const minutesEl = document.getElementById("countdown-minutes");
    const secondsEl = document.getElementById("countdown-seconds");

    if (daysEl) daysEl.innerText = String(days).padStart(2, "0");
    if (hoursEl) hoursEl.innerText = String(hours).padStart(2, "0");
    if (minutesEl) minutesEl.innerText = String(minutes).padStart(2, "0");
    if (secondsEl) secondsEl.innerText = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
