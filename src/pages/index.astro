---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProblemSection from "../components/ProblemSection.astro";
import FeaturesSection from "../components/FeaturesSection.astro";
import SpySection from "../components/SpySection.astro";
import TargetAudience from "../components/TargetAudience.astro";
import OfferSection from "../components/OfferSection.astro";
import ChoiceSection from "../components/ChoiceSection.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner";
---

<Layout title="Máquina de Conteúdo Eleitoral - Transforme Pautas em Votos">
  <Header />
  <main>
    <Hero />
    <ProblemSection />
    <FeaturesSection />
    <SpySection />
    <TargetAudience />
    <OfferSection />
    <ChoiceSection />
  </main>
  <Footer />
  <CookieBanner client:idle />
</Layout>
