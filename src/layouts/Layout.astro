---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Máquina de Conteúdo Eleitoral · Estratégia Digital para Pré-Campanha",
  description = "Automatize a produção de conteúdos eleitorais em múltiplos formatos: Reels, Carrosséis, Stories, WhatsApp e Discursos com inteligência tática.",
  image = "/og-image.png", // Adicione a imagem de preview (1200x630px) na pasta public/
  canonicalURL = Astro.url.href,
} = Astro.props;

// ============================================
// 🔥 CORREÇÃO: GTM Otimizado com Lazy Load
// ============================================
const GTM_ID = "GTM-T7D2C9MR"; // Seu GTM ID
const GA_ID = "G-N405D30YMK"; // Seu GA4 ID
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Máquina Eleitoral" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Máquina de Conteúdo Eleitoral" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- ============================================ -->
    <!-- 🔥 GTM OTIMIZADO: Carregamento Assíncrono     -->
    <!-- ============================================ -->
    <script is:inline>
      // Inicializa o dataLayer imediatamente
      window.dataLayer = window.dataLayer || [];

      // Função que carrega o GTM apenas após a interação do usuário ou com idle
      function loadGTM() {
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtm.js?id=" + "{GTM_ID}";
        document.head.appendChild(script);

        // Push do evento de inicialização
        window.dataLayer.push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });
      }

      // ============================================
      // Estratégia Híbrida (Recomendada)
      // ============================================

      // Carrega com idle (não bloqueia renderização)
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadGTM, { timeout: 3000 });
      } else {
        setTimeout(loadGTM, 2000);
      }

      // Também carrega na interação (para usuários que interagem antes do idle)
      ["click", "touchstart", "scroll", "keydown"].forEach((event) => {
        document.addEventListener(event, loadOnInteraction, {
          once: true,
          passive: true,
        });
      });
    </script>

    <!-- Fallback: carregamento direto apenas se o usuário permitir (GDPR) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T7D2C9MR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
  </head>

  <body
    class="bg-[#182838] text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#0894B0] selection:text-white min-h-screen flex flex-col justify-between overflow-x-hidden"
  >
    <!-- ============================================ -->
    <!-- 🔥 GTM NOSCRIPT (Fallback)                   -->
    <!-- ============================================ -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T7D2C9MR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- Slot para os componentes da página -->
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Smooth Scroll Behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #182838;
  }
  ::-webkit-scrollbar-thumb {
    background: #0894b0;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #067a92;
  }
</style>
