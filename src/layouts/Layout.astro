---
import "../styles/global.css";
import UTMify from "../components/UTMify.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Máquina de Conteúdo Eleitoral · Estratégia Digital para Pré-Campanha",
  description = "Automatize a produção de conteúdos eleitorais em múltiplos formatos: Reels, Carrosséis, Stories, WhatsApp e Discursos com inteligência tática.",
  image = "/og-image.png",
  canonicalURL = Astro.url.href,
} = Astro.props;

const GTM_ID = "GTM-T7D2C9MR";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Máquina Eleitoral" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Máquina de Conteúdo Eleitoral" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Preconectar a Kiwify -->
    <link rel="preload" href="pay.kiwify.com.br" />

    <noscript>
      <link rel="stylesheet" href="pay.kiwify.com.br" />
    </noscript>

    <!-- DNS Prefetch -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://tagmanager.google.com" />

    <!-- ============================================ -->
    <!-- 🔥 GOOGLE TAG MANAGER - INSTALAÇÃO OFICIAL  -->
    <!-- ============================================ -->
    <script is:inline>
      // Código EXATAMENTE como no GTM
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-T7D2C9MR");
    </script>
    <!-- End Google Tag Manager -->
  </head>

  <body
    class="bg-[#182838] text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#0894B0] selection:text-white min-h-screen flex flex-col justify-between overflow-x-hidden"
  >
    <!-- ============================================ -->
    <!-- 🔥 GTM NOSCRIPT - INSTALAÇÃO OFICIAL        -->
    <!-- ============================================ -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-T7D2C9MR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <main>
      <slot />
    </main>

    <!-- ============================================ -->
    <!-- 🔥 UTMIFY - CARREGAMENTO OTIMIZADO         -->
    <!-- ============================================ -->
    <UTMify />
  </body>
</html>

<style is:global>
  /* Smooth Scroll Behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #182838;
  }
  ::-webkit-scrollbar-thumb {
    background: #0894b0;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #067a92;
  }
</style>
