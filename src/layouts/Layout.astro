---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Máquina de Conteúdo Eleitoral · Estratégia Digital para Pré-Campanha",
  description = "Automatize a produção de conteúdos eleitorais em múltiplos formatos: Reels, Carrosséis, Stories, WhatsApp e Discursos com inteligência tática.",
  image = "/og-image.png",
  canonicalURL = Astro.url.href,
} = Astro.props;

const GTM_ID = "GTM-T7D2C9MR";
const GA_ID = "G-N405D30YMK";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Máquina Eleitoral" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Máquina de Conteúdo Eleitoral" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- ============================================ -->
    <!-- 🔥 GTM CORRIGIDO - Carregamento Otimizado    -->
    <!-- ============================================ -->
    <script is:inline>
      // 1. Inicializa o dataLayer ANTES do GTM
      window.dataLayer = window.dataLayer || [];

      // 2. Função para carregar o GTM
      function loadGTM() {
        // Evita carregar múltiplas vezes
        if (window._gtm_loaded) return;
        window._gtm_loaded = true;

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`;
        document.head.appendChild(script);

        // Notifica que o GTM foi carregado
        window.dataLayer.push({
          event: "gtm.js",
          "gtm.start": new Date().getTime(),
        });
      }

      // 3. Carrega GTM de forma otimizada
      if (document.readyState === "complete") {
        // Já carregou, carrega imediatamente
        loadGTM();
      } else {
        // Aguarda o carregamento completo da página
        window.addEventListener("load", loadGTM);
      }

      // 4. Fallback: carrega após 2 segundos se ainda não carregou
      setTimeout(() => {
        if (!window._gtm_loaded) {
          loadGTM();
        }
      }, 2000);
    </script>

    <!-- Script para eventos do React (opcional, mas recomendado) -->
    <script is:inline>
      // Função global para disparar eventos do GTM
      window.gtmPush = function (eventName, eventData = {}) {
        if (window.dataLayer) {
          window.dataLayer.push({
            event: eventName,
            ...eventData,
          });
        }
      };
    </script>
  </head>

  <body
    class="bg-[#182838] text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#0894B0] selection:text-white min-h-screen flex flex-col justify-between overflow-x-hidden"
  >
    <!-- ============================================ -->
    <!-- 🔥 GTM NOSCRIPT (Corrigido)                  -->
    <!-- ============================================ -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Smooth Scroll Behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #182838;
  }
  ::-webkit-scrollbar-thumb {
    background: #0894b0;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #067a92;
  }
</style>
